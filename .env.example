# =====================================================================================================================
# PERFIL DE PRODUÇÃO (change 42-upgrade-openai-remaining-models, D-orq-193)
#
# Este arquivo é o perfil de produção de melhor qualidade: provedores reais, funções ligadas, modelos novos, um valor por
# linha e, em cada uma, o efeito e o custo aproximado. Copie para o .env do servidor e preencha SÓ os segredos (chaves e
# tokens ficam em branco aqui) e o ADMIN_API_TOKEN.
#
# O docker-compose.yml da raiz (stack local) SOBREPÕE este perfil: provedores em mock, funções de IA desligadas e chaves
# zeradas (bloco x-safe-env). Por isso copiar este arquivo para o backend/.env local não gasta nada pelo compose. Rodar o
# backend FORA do compose (npm run start) com uma chave real preenchida GASTA crédito de verdade.
#
# Linha comentada com valor (# NOME=valor) = o código já tem esse valor como padrão: descomente só para trocar. Assim a
# próxima troca de modelo padrão chega ao servidor sem editar o .env (foi o modelo fixo no .env que manteve o gpt-4o).
# Mudar qualquer variável exige reiniciar a API e o worker (os serviços leem a configuração ao nascer).
# Custos são ordem de grandeza pelas tabelas de preço do repositório (modules/ai/openai-llm-pricing.ts); Luna = gpt-6-luna
# (US$ 0,10 entrada / 0,50 saída por milhão de tokens), Terra = gpt-6.1-terra (US$ 1 / 5).
# Um teste de guarda (src/common/config/env-example.guard.spec.ts) falha se o código ler uma variável sem linha aqui, se
# uma linha não tiver leitor ou se um segredo tiver valor.
# =====================================================================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stepup_user
DB_PASSWORD=secret123
DB_DATABASE=flyer_db

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=604800

# App
PORT=3001
NODE_ENV=development

# Upload
# Diretório dos uploads. Relativo (./uploads) é resolvido contra o diretório corrente do processo UMA VEZ, no boot (log
# "Uploads em <caminho>"); em produção o cwd do PM2 é /opt/encarte/backend. Recomendado em produção: caminho absoluto, igual
# para a API e o worker (o render Remotion troca o cwd durante o bundle).
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Base URL
BASE_URL=http://localhost:3001/v1
CDN_URL=http://localhost:3001/uploads
FRONTEND_URL=http://localhost:3000

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Encartes" <no-reply@encartes.local>

# =====================================================================================================================
# Segredos: SEMPRE em branco aqui; o valor real vive só no .env do servidor.
# =====================================================================================================================
# OpenAI: texto, visão, imagem, embeddings. Sem chave, as funções de IA respondem o erro de hoje ou o plano de reserva.
OPENAI_API_KEY=
# Pixabay: busca de imagens do encarte (gratuito).
PIXABAY_API_KEY=
# Replicate: segmentação SAM (remoção de fundo). Cobrado por execução.
REPLICATE_API_TOKEN=
# DotCompany: catálogo por EAN. Sem token, nenhuma consulta é feita e o encarte segue pelo casamento por nome.
DOTCOMPANY_API_TOKEN=
# fal.ai: vídeo do mascote (Kling Avatar e ação) no pipeline real dos comerciais.
FAL_API_KEY=
# ElevenLabs: voz (TTS) e trilha dos comerciais.
ELEVENLABS_API_KEY=
# Gemini: imagens do kit e keyframes, leitura de clipe e do gate de boca dos comerciais.
GEMINI_API_KEY=
# Runway e HeyGen: provedores de animação por IA (legado das Animações; só gastam se um pipeline os escolher).
RUNWAY_API_KEY=
HEYGEN_API_KEY=
# OBRIGATÓRIO em produção: protege as rotas administrativas (POST /v1/template-scenes/admin/gc, GET /v1/ai/gallery/embedding-stats
# e as demais com o header x-admin-token). Sem valor, essas rotas respondem 403. Use um valor LONGO e ALEATÓRIO, por exemplo
# o resultado de: openssl rand -hex 32
ADMIN_API_TOKEN=

# =====================================================================================================================
# Créditos: DESLIGADOS no perfil (A-1). Nenhuma rota concede saldo hoje: com a cobrança ligada, todo uso pago responderia
# 402 INSUFFICIENT_CREDITS. Ligar só depois de existir uma forma de conceder saldo.
# =====================================================================================================================
# Cobrança das Animações por crédito.
AI_CREDITS_ENABLED=false
# Cobrança dos comerciais (família 'commercials').
MC_CREDITS_ENABLED=false

# =====================================================================================================================
# Modelos de texto e visão (OpenAI). Padrão do código: Luna; Terra onde um erro vira dinheiro gasto depois.
# gpt-4o e gpt-4o-mini SAEM DO AR em 2027-01-14: o aviso ao subir lembra enquanto a variável ainda apontar para eles.
# Para voltar um grupo (só até essa data): ponha o modelo antigo na variável e reinicie API e worker.
# =====================================================================================================================
# Texto do Gerar template, assistente de elemento, template por imagem e em camadas, layout social e plano de montagem
# (Luna, esforço baixo, cerca de US$ 0,003 por geração com 2 imagens).
# OPENAI_TEXT_MODEL=gpt-6-luna
# Roteiro do mascote, traduções dos comerciais e intenção da imagem do template (Luna, esforço nenhum, frações de centavo).
# OPENAI_FAST_TEXT_MODEL=gpt-6-luna
# Diretor dos comerciais (4 formatos, uma chamada por projeto, cerca de US$ 0,016 por roteiro de 6 ofertas).
# MC_DIRECTOR_MODEL=gpt-6.1-terra
# Descrição canônica do kit com visão (uma chamada por kit; leitura errada vira 4 imagens de US$ 0,134 refeitas).
# MC_KIT_VISION_MODEL=gpt-6.1-terra
# Juízes de EAN do pipeline antigo (só rodam com EAN_JOB_RUNNER_ENABLED=true). O B vale o A quando ausente. Modelo sem preço
# na tabela deixa o juiz indisponível (o log avisa ao subir).
# EAN_JUDGE_MODEL_A=gpt-6.1-terra
# EAN_JUDGE_MODEL_B=gpt-6.1-terra
# Modelo de embeddings da Galeria (busca de fotos por similaridade).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Tentativas de nova pergunta quando a IA responde fora do schema (cada uma é uma chamada paga com o seu prazo).
OPENAI_STRUCTURED_RESPONSE_RETRY_ATTEMPTS=1
# Prazo (ms) da imagem da cena do Template Pro. Não vale para as cinco features de produto (cada uma tem o seu prazo).
OPENAI_TIMEOUT_MS=180000

# Modelo e prazo das cinco features de IA de produto do encarte (ortografia, categorização, leitura do nome, leitura da
# foto da Galeria e tradução do termo do Pixabay). Cada uma tem a sua variável: NÃO herdam OPENAI_TEXT_MODEL,
# OPENAI_FAST_TEXT_MODEL nem OPENAI_TIMEOUT_MS. Vazia ou ausente vale o padrão novo (abaixo). Modelos aceitos: a família
# gpt-6 (padrão) ou, para voltar, os modelos de hoje (gpt-4o, gpt-4o-mini). Outra família recebe os parâmetros de hoje e
# pode ser recusada pela OpenAI. Voltar uma feature: ponha o modelo antigo na variável dela e reinicie.
# OPENAI_SPELLCHECK_MODEL=gpt-6-luna
# OPENAI_CATEGORIZATION_MODEL=gpt-6-luna
# OPENAI_NAME_PARSER_MODEL=gpt-6-luna
# OPENAI_GALLERY_VISION_MODEL=gpt-6.1-terra
# OPENAI_TRANSLATION_MODEL=gpt-6-luna
# Prazo por chamada, em milissegundos (vazio, 0, negativo ou texto valem o padrão de cada uma). O SDK não repete a chamada
# sozinho (maxRetries 0).
# OPENAI_TRANSLATION_TIMEOUT_MS=10000
# OPENAI_SPELLCHECK_TIMEOUT_MS=30000
# OPENAI_CATEGORIZATION_TIMEOUT_MS=60000
# OPENAI_NAME_PARSER_TIMEOUT_MS=60000
# OPENAI_GALLERY_VISION_TIMEOUT_MS=60000

# =====================================================================================================================
# Imagem geral (templates antigos: Gerar template, camadas e imagem base das animações). Sem fallback DALL-E (o dall-e-3
# foi desligado pela OpenAI, conferido na task 1.1). Custo por imagem igual ao do 2.5 (US$ 8 imagem de entrada, US$ 5 texto, US$ 30 imagem de saída
# por milhão de tokens); qualidade 'high' custa cerca de US$ 0,13 no tamanho nativo. 'xhigh' e 'max' existem, mas custo e
# tempo nunca foram medidos aqui: só depois de uma medida paga.
# =====================================================================================================================
# OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# OPENAI_IMAGE_PREVIEW_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_QUALITY=high
# Qualidade da prévia (só com OPENAI_IMAGE_DEFAULT_MODE=preview; nenhum chamador a pede hoje).
OPENAI_IMAGE_PREVIEW_QUALITY=medium
OPENAI_IMAGE_DEFAULT_MODE=final
OPENAI_IMAGE_BACKGROUND=opaque
# PNG, sem perda: o JPEG 85 deixava serrilhado nas cores chapadas e no texto. Arquivos de 2 a 4 MB em vez de cerca de
# 300 KB (mais disco em /uploads); o custo por imagem não muda. Os placeholders do Gerar template seguem JPEG (fixo no código).
OPENAI_IMAGE_OUTPUT_FORMAT=png
# Compressão (0 a 100): só vale com OPENAI_IMAGE_OUTPUT_FORMAT=jpeg ou webp.
# OPENAI_IMAGE_OUTPUT_COMPRESSION=85
# Fidelidade da imagem de entrada: só vale com gpt-image-1.5 e gpt-image-1-mini (a OpenAI os desliga em 2026-12-01); sem
# efeito nos modelos 2.x.
# OPENAI_IMAGE_INPUT_FIDELITY=high
# Imagens em paralelo e repetição de erro temporário (429 de taxa e 5xx) da imagem geral; a espera cresce até o teto.
OPENAI_IMAGE_CONCURRENCY_LIMIT=2
OPENAI_IMAGE_RETRY_ATTEMPTS=2
OPENAI_IMAGE_RETRY_BASE_DELAY_MS=750
OPENAI_IMAGE_RETRY_MAX_DELAY_MS=5000
# Tarifas para a telemetria de custo de modelo FORA da tabela de preços (US$ por milhão de tokens; US$ por imagem). Vazio =
# sem estimativa. Aceita também OPENAI_COST_<MODELO>_INPUT_1M_USD, OPENAI_COST_<MODELO>_OUTPUT_1M_USD e
# OPENAI_COST_IMAGE_<MODO>_USD (nomes montados em tempo de execução, cobertos por estas linhas no guarda).
# OPENAI_COST_TEXT_INPUT_1M_USD=
# OPENAI_COST_TEXT_OUTPUT_1M_USD=
# OPENAI_COST_IMAGE_FINAL_USD=
# OPENAI_COST_IMAGE_PREVIEW_USD=

# =====================================================================================================================
# IA de produto do encarte (editor e Encarte Pro): todas LIGADAS (custo em Luna e Terra: frações de centavo por lote).
# =====================================================================================================================
# Ortografia dos produtos. Só 'false' desliga (a rota responde AI_SERVICE_ERROR). Até N chamadas em paralelo por revisão
# (padrão 4; inválido vale 4).
AI_SPELLCHECK_ENABLED=true
AI_SPELLCHECK_CONCURRENCY=4
# Categorização dos produtos (Luna): lote de 40, até 500 produtos por pedido.
AI_PRODUCT_CATEGORIZATION_ENABLED=true
AI_PRODUCT_CATEGORIZATION_BATCH_SIZE=40
AI_PRODUCT_CATEGORIZATION_MAX_PRODUCTS=500
# Leitura do nome do produto (marca, peso, tipo) que melhora o casamento de fotos (Luna).
AI_NAME_PARSER_ENABLED=true
# Leitura da foto enviada à Galeria (Terra, uma chamada por foto) e quantas leem ao mesmo tempo.
AI_IMAGE_METADATA_ENABLED=true
AI_IMAGE_METADATA_CONCURRENCY=4
# Embeddings da Galeria (pgvector): busca de fotos por similaridade (centavos). Corte mínimo de similaridade e reforço (+)
# das fotos preferidas do cliente.
AI_GALLERY_EMBEDDING_ENABLED=true
AI_PRODUCT_IMAGE_MATCH_THRESHOLD=0.35
AI_CLIENT_IMAGE_PREF_BOOST=0.15
# Plano de montagem automática do encarte (Luna, esforço baixo): até 300 produtos por pedido; sem IA vale o plano de reserva.
AI_FLYER_ASSEMBLY_ENABLED=true
AI_FLYER_ASSEMBLY_MAX_PRODUCTS=300
# Log estruturado por produto do casamento de fotos: 1 só para depurar (volume alto de log).
AI_MATCH_DEBUG=0

# =====================================================================================================================
# Catálogo DotCompany por EAN (openspec catalogo-dotcompany-ean)
# A DotCompany limita só por minuto (Free 30, Starter 120, Pro 600 req/min) e pelo saldo de créditos (1 crédito = R$ 0,01;
# EAN encontrado = 4 créditos = R$ 0,04; não encontrado é grátis). Os limites por hora/dia abaixo são NOSSOS: trava de
# orçamento. Sem token, nenhuma consulta é feita e o encarte segue pelo casamento por nome.
# =====================================================================================================================
DOTCOMPANY_BASE_URL=https://erp.dotcompany.com.br/api/v1
DOTCOMPANY_RPM=30
DOTCOMPANY_MAX_REQUESTS_HOUR=600
DOTCOMPANY_MAX_REQUESTS_DAY=5000
DOTCOMPANY_MAX_CREDITS_HOUR=4000
DOTCOMPANY_MAX_CREDITS_DAY=12000
# Abaixo disso as importações em lote param; o encarte continua consultando.
DOTCOMPANY_RESERVE_CREDITS=400
# Abaixo disso sai o e-mail de saldo baixo (uma vez, até o saldo subir de novo).
DOTCOMPANY_ALERT_CREDITS=1000
DOTCOMPANY_BALANCE_REFRESH_MIN=15
DOTCOMPANY_ALERT_EMAIL=
# Runner dos jobs de importação de cadastro e teto padrão por job (créditos; 12000 = R$ 120).
EAN_IMPORT_RUNNER_ENABLED=true
EAN_IMPORT_DEFAULT_CAP_CREDITS=12000
# Resolução por EAN na busca de imagens do encarte (prazo da requisição, em ms).
EAN_FLYER_RESOLVE_ENABLED=true
EAN_FLYER_RESOLVE_TIMEOUT_MS=20000
# Pipeline antigo de vínculo EAN por juízes de IA (substituído pela resolução por EAN). DESLIGADO: gasta chamadas de Terra
# sem ganho sobre o catálogo (A-10). Os limites abaixo só valem com ele ligado: teto em dólar por job, jobs em paralelo
# (1 a 16) e repetições do juiz (0 a 3).
EAN_JOB_RUNNER_ENABLED=false
EAN_JOB_COST_CAP_USD=50
EAN_JOB_CONCURRENCY=4
EAN_JUDGE_MAX_RETRIES=1

# =====================================================================================================================
# Comerciais com mascote (módulo commercials): provedores REAIS, formatos novos ligados.
# =====================================================================================================================
# Liga rotas e consumers do módulo.
MC_ENABLED=true
# Roteiro do diretor pela OpenAI (Terra, cerca de US$ 0,016 por roteiro de 6 ofertas) em vez do mock.
MC_SCRIPT_PROVIDER=openai
# Kit do mascote pela Gemini: 4 referências por kit a cerca de US$ 0,134 cada (Nano Banana Pro) e candidatos de logo.
MC_KIT_PROVIDER=gemini
# Vídeo real: fal.ai (Kling Avatar: US$ 0,0562/s no tier econômico, 0,115/s no premium), ElevenLabs (voz e trilha) e Gemini.
MC_PIPELINE_PROVIDER=real
# Derivação PT→EN da cena pela OpenAI (Luna, frações de centavo) em vez do fallback em português.
MC_TRANSLATION_PROVIDER=openai
# Executor v2 (ADR-001), congelado por projeto na criação: off | all | cohort. Os formatos novos de MC_FORMATS EXIGEM 'all'
# (com off ou cohort a criação recusa com 422 PIPELINE_V2_REQUIRED); 'all' também põe os projetos novos de cenas no v2.
# Projetos já criados não mudam. Para voltar: off e MC_FORMATS vazio (PV-16 da change 42).
MC_PIPELINE_V2=all
# ids de usuário (vírgula) quando MC_PIPELINE_V2=cohort.
MC_PIPELINE_V2_USERS=
# Formatos novos admitidos (change video-formatos-personagem), lista separada por vírgula; vazio = nenhum formato novo (o de
# cenas sempre passa). Token desconhecido derruba o boot.
MC_FORMATS=talking_art,offer_carousel,offer_piece
# Limite de referências enviadas ao gerador de keyframe (custo por keyframe cresce com cada uma).
MC_KEYFRAME_MAX_REFERENCES=3
# Experimento P4: incluir a imagem original do mascote no keyframe. Desligado: sem medida de ganho e com custo a mais.
MC_KEYFRAME_INCLUDE_ORIGINAL=false
# Entrega da voz (ElevenLabs voice_settings) — vale para o preview E o TTS das cenas.
# Velocidade 0.7–1.2 (1 = natural; >1 mais rápido); estilo 0–1 (expressividade); estabilidade 0–1 (menor = mais emoção;
# eleven_v3 arredonda para 0 / 0.5 / 1); similaridade 0–1 (fidelidade ao timbre); speaker boost liga/desliga.
MC_TTS_SPEED=1.12
MC_TTS_STYLE=0.45
MC_TTS_STABILITY=0.4
MC_TTS_SIMILARITY=0.75
MC_TTS_SPEAKER_BOOST=true
# Inspeção do clipe (Gemini visão): texto inventado => regera até 3x (cada regeração é um clipe pago); off desliga.
MC_CLIP_TEXT_CHECK=on
# Motores de fala por tier e origem (design D2): "modelo no fal | US$ por segundo | máximo de segundos por chamada"
MC_TALK_ENGINE_ECONOMICO=fal-ai/kling-video/ai-avatar/v2/standard|0.0562|15
MC_TALK_ENGINE_PREMIUM=fal-ai/kling-video/ai-avatar/v2/pro|0.115|15
MC_TALK_ENGINE_LOGO=minimax/h3-max/lip-sync/image-to-video|0.08|15
# Premium alternativo do bake-off (tarefa 7.1): OmniHuman 1.5 em 1080p, áudio <= 30 s por chamada (720p: <= 60 s), US$ 0,16/s.
# Fica comentado: sem calibração registrada (D-9); uma peça de 20 s sai por cerca de US$ 3,20 em vez de 2,30.
# MC_TALK_ENGINE_PREMIUM=fal-ai/bytedance/omnihuman/v1.5|0.16|30
# Fala contínua (change video-fala-continua, design D16): as falas consecutivas viram UMA chamada do motor por trecho. A flag
# é lida só pela API, na criação do projeto, e fica CONGELADA no roteiro dele (talkMode). DESLIGADA: o teto abaixo (10 s) é
# provisório e a calibração da task 3.4 está pendente; trecho mal calibrado pede regravação paga. Ligar depois dela.
MC_TALK_CONTINUOUS=false
# Teto (s) de áudio por trecho. Acima dele as falas se dividem em mais trechos. Sempre <= maxChunkS do MC_TALK_ENGINE_*
# (15 hoje); vazio = maxChunkS do motor. Valor que não seja número > 0 derruba o boot. Regravar uma fala regrava o trecho
# inteiro e os seguintes: quanto maior o teto, mais caro refazer uma frase.
MC_TALK_CHUNK_MAX_S=10
# Espera (s) por segundo de áudio no provider_wait do talk de trecho (lido pelo worker); piso 15 min, teto 40 min.
MC_TALK_POLL_PER_AUDIO_S=150
# Modelo das 4 referências do kit; vazio = nano-banana-pro-preview (Nano Banana Pro, US$ 0,134 por imagem). Ex.: gemini-nano-banana-2.1
# (US$ 0,034, mais barato e de menor qualidade).
GEMINI_IMAGE_MODEL_REFS=
# Tarifas do custo registrado do kit: "modelo|US$ por imagem|US$ por 1M tokens de entrada|US$ por 1M de saída", separadas por
# vírgula. Vazio = tabela padrão abaixo (domain/mc-kit-costs.ts); cada entrada substitui a do mesmo modelo (campo vazio
# herda o padrão) ou acrescenta um modelo (os três números obrigatórios). Mal escrita derruba o boot.
# Padrão: nano-banana-pro-preview|0.134|2|12, gemini-3-pro-image-preview|0.134|2|12, gemini-nano-banana-2.1|0.034|2|12,
#         gpt-6-luna|0|0.1|0.5, gpt-6.1-terra|0|1|5, gpt-4o|0|2.5|10 e gpt-4o-mini|0|0.15|0.6 (os dois últimos só para a
#         volta; saem do ar em 2027-01-14), gemini-3.8-flash|0|0.5|3
# (imagens: design.md; tokens da 2.1 = teto da Pro; gemini-3.8-flash = referência do Gemini 3 Flash, a confirmar)
MC_KIT_PRICES=
# Candidatos de mascotização por rodada (kit de logo), sempre entre 4 e 6: 6 dão mais escolha por cerca de US$ 0,80 a rodada
# (4 custam cerca de US$ 0,54).
MC_KIT_CANDIDATE_COUNT=6
# Opcional: pasta com referências de estilo {cartoon_2d|3d_render|realistic}-{1..3}.png enviadas junto com o logo na rodada
# de candidatos; vazio = só o logo + bloco de estilo.
MC_KIT_STYLE_REFS_DIR=
# Personagem sem fundo e enquadramento de corpo (change video-mascote-transparente; fala gerada sobre cor-chave e recorte no
# ffmpeg do worker, custo de API a mais = 0). DESLIGADO: em calibração; ligar depois de a validação do recorte fechar.
# Desligado: 422 CHARACTER_CUTOUT_DISABLED e GET /v1/commercials/config informa characterCutout.enabled=false. Lida só pela API.
MC_CHARACTER_CUTOUT=false
# GC diário de uploads no worker (animations + commercials): só APAGA com false. Fica true (simulação) até o dono revisar o
# que o GC apagaria, porque arquivo apagado não volta sozinho.
GC_DRY_RUN=true
# Executável do navegador do render (Alpine: /usr/bin/chromium-browser). PREENCHA com o caminho do Chromium do servidor: vazio =
# navegador ausente, e 'offer_carousel' fica indisponível no preflight E a criação recusa com 422 RENDER_UNAVAILABLE.
MC_RENDER_BROWSER=
# Render da composição Remotion do F2 'ofertas em sequência' (fila mc.render, concorrência 1, expiração 900 s)
# Versão das composições (@chroma/video-templates#compositionVersion); entra no hash do render; com o pacote carregado vale a
# versão dele — este valor é o do renderizador mock.
MC_COMPOSITION_VERSION=0.3.0
# Base das URLs de mídia que o navegador do render busca (vazio = http://127.0.0.1:3001; stack docker: http://backend:3001
# se o worker não alcança a API em 127.0.0.1).
MC_RENDER_ASSET_BASE_URL=
# remotion | mock — força o renderizador do F2; vazio = mock com MC_PIPELINE_PROVIDER=mock, senão remotion.
MC_CAROUSEL_RENDERER=
# Opcional: checkout local do pacote de templates (bundle e @remotion/* resolvidos dele); vazio = node_modules/@chroma/video-templates.
MC_VIDEO_TEMPLATES_DIR=
# Só para o PREFLIGHT: caminho da DejaVuSans.ttf quando instalada fora dos caminhos usuais e sem fontconfig. Vazio = automático.
# O drawtext NÃO lê esta variável: ele resolve a fonte pelo fontconfig (instale ttf-dejavu/fonts-dejavu-core + fontconfig).
MC_RENDER_FONT_FILE=
# Binários do ffmpeg e do ffprobe no worker; o preflight reporta a versão no /v1/health. Deixe as linhas AUSENTES para valer
# o do PATH: vazio NÃO cai no padrão (o preflight executa ''), por isso ficam comentadas.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Só com o provedor mock (nenhum vale em produção; ficam comentadas): latência simulada do pipeline, teto (s) do TTS mock
# (15 chars/s; mantenha ACIMA do maxChunkS de 15 s para exercitar SPEECH_SENTENCE_TOO_LONG), veredito do gate de boca
# (passed | blocked | undecided), localização do logo (found | not_found | low), preço sob a janela (none | overlap | error),
# estabilidade do recorte (stable | unstable), veredito de inspeção do clipe (fixture de QA, só no worker), pose do talk mock (on).
# MC_PIPELINE_MOCK_LATENCY_MS=4000
# MC_MOCK_TTS_MAX_S=20
# MC_MOUTH_GATE_MOCK=passed
# MC_LOGO_LOCATOR_MOCK=found
# MC_PRICE_DETECT_MOCK=none
# MC_CUTOUT_MOCK=stable
# MC_CLIP_INSPECTION_MOCK=
# MC_MOCK_POSE=on
# ElevenLabs: modelo da trilha (vazio = padrão da conta; fixar um id que a conta não tem produz 422) e prazo (ms) do TTS.
# ELEVENLABS_MUSIC_MODEL=
ELEVENLABS_TTS_TIMEOUT_MS=120000

# Animações por IA (legado; A-11: valor de hoje enquanto "Animações IA: linha ativa ou legado" não é decidido).
# Só 'false' desliga as animações; o GC de uploads também roda com MC_ENABLED=true (shared/gc/uploads-gc.service.ts).
ANIMATIONS_ENABLED=true
# Vazio = o provedor de cada pipeline (fal Kling ou Runway, pagos). 'mock' desvia o vídeo para o simulado (sem custo).
# IMAGE_TO_VIDEO_PROVIDER=mock
# Latência (ms) do vídeo simulado, só com IMAGE_TO_VIDEO_PROVIDER=mock.
# IMAGE_TO_VIDEO_MOCK_LATENCY_MS=6000

# =====================================================================================================================
# Cena de template (Templates v2, change add-template-scene-persistence). O compose local já define estes valores.
# =====================================================================================================================
# Liga o módulo de cenas (guard 404 quando falso) e a fila no backend/worker.
TEMPLATE_SCENE_ENABLED=true
# openai = imagem real (qualidade high: cerca de US$ 0,13 por imagem no tamanho nativo; refação e edição com máscara somam);
# mock = sem custo (padrão do compose local).
TEMPLATE_SCENE_IMAGE_PROVIDER=openai
# TEMPLATE_SCENE_IMAGE_MODEL=gpt-image-2.6-sunburst
TEMPLATE_SCENE_IMAGE_QUALITY=high
# Qualidade das edições com máscara.
TEMPLATE_SCENE_EDIT_QUALITY=high
# Imagens da cena ao mesmo tempo (fila própria) e leituras do Diretor em paralelo.
TEMPLATE_SCENE_CONCURRENCY=1
TEMPLATE_SCENE_DIRECTOR_CONCURRENCY=4
# Chamadas pagas por mensagem do usuário: a refação do texto pintado precisa da quarta; com 3, a segunda imagem sai sem juiz.
TEMPLATE_SCENE_MAX_PAID_CALLS_PER_MESSAGE=4
# Modelo de visão da conferência da edição local, do Diretor (lê a mensagem e a imagem, D-34) e da referência de encarte
# (devolve a ficha-conceito): todos Luna.
# TEMPLATE_SCENE_VISION_MODEL=gpt-6-luna
# TEMPLATE_SCENE_DIRECTOR_MODEL=gpt-6-luna
# TEMPLATE_SCENE_REFERENCE_MODEL=gpt-6-luna
# Tempo máximo (ms) da visão (passou, a resposta sai das métricas) e da leitura do Diretor (passou, a versão falha).
TEMPLATE_SCENE_VISION_TIMEOUT_MS=20000
TEMPLATE_SCENE_DIRECTOR_TIMEOUT_MS=20000
# Janela (s) em que o cliente ainda pode Parar antes da imagem (D-29).
TEMPLATE_SCENE_WINDOW_SECONDS=5
# Rotas de referência de encarte (404 REFERENCE_DISABLED quando falso); cada uso custa cerca de US$ 0,14.
TEMPLATE_SCENE_REFERENCE_ENABLED=true
# Retenção e GC das cenas: arquivos intermediários vivem 7 dias, cenas excluídas 30, e ficam as 20 versões prontas mais recentes
# com master. O GC apaga DE VERDADE (false; pedido do dono; ausente = true = só simula). Disparo manual: x-admin-token.
TEMPLATE_SCENE_ASSET_TTL_DAYS=7
TEMPLATE_SCENE_DELETED_RETENTION_DAYS=30
TEMPLATE_SCENE_MASTERS_KEPT=20
TEMPLATE_SCENE_GC_DRY_RUN=false
# Latência simulada do provedor mock e espera mínima do mock quando o pedido traz #lento (testes de cancelamento). Só mock.
# TEMPLATE_SCENE_MOCK_LATENCY_MS=20000
# TEMPLATE_SCENE_MOCK_SLOW_MS=3000

# =====================================================================================================================
# Encarte Pro: sugestão de estrutura por IA (rota N19, change 24). Lidas uma vez, ao subir a API; o compose local usa mock.
# =====================================================================================================================
# Só 'false' desliga a rota (422 FLYER_PRO_STRUCTURE_AI_DISABLED).
FLYER_PRO_STRUCTURE_AI_ENABLED=true
# real = OpenAI (Luna, cerca de US$ 0,002 por sugestão); mock = padrão do compose local (valor desconhecido cai em mock).
FLYER_PRO_STRUCTURE_AI_PROVIDER=real
# Precisa ter preço em openai-llm-pricing.ts, senão 422 MODEL_PRICE_UNKNOWN.
# FLYER_PRO_STRUCTURE_AI_MODEL=gpt-6-luna
# Esforço de raciocínio: none | low | medium (outro valor vira low). 'low' calibrado na change 24; 'medium' pede medida e prazo maior.
FLYER_PRO_STRUCTURE_AI_EFFORT=low
# Prazo (ms) da chamada ao provedor (vale para o mock também); estourou, 503 TIMEOUT.
FLYER_PRO_STRUCTURE_AI_TIMEOUT_MS=25000
# Sugestões atendidas por encarte em 60 minutos; acima disso a rota responde 429 HOURLY_LIMIT (trava de custo).
FLYER_PRO_STRUCTURE_AI_MAX_PER_HOUR=20
# Destaques novos por sugestão (os últimos são cortados).
FLYER_PRO_STRUCTURE_AI_MAX_HEROES=12
# Encartes anteriores do cliente usados como exemplo, de 0 a 10 (0 desliga a leitura).
FLYER_PRO_STRUCTURE_AI_EXAMPLES=3

# =====================================================================================================================
# Encarte Pro: job de fotos, categorias e ortografia (rotas N14 a N16, change 28). Lidas uma vez, ao subir o processo (API e
# worker): mudar qualquer uma exige reiniciar. O prazo da chamada (BATCH_DEADLINE_MS, 240 s) deve ficar abaixo do prazo do lote
# na fila (BATCH_EXPIRE_SECONDS, 300 s), senão a fila dá o lote por perdido antes do prazo da chamada.
# =====================================================================================================================
# Só 'false' desliga o job (N14 responde 422 FLYER_PRO_ENRICHMENT_DISABLED; o worker não consome).
FLYER_PRO_ENRICH_ENABLED=true
# real = as três fases rodam sobre os serviços de IA do editor: fotos (Galeria, EAN da DotCompany a R$ 0,04 por EAN encontrado
# e leitor de nomes da OpenAI), categorias e ortografia (OpenAI, Luna); categorias e ortografia só rodam com a flag e a chave
# da OpenAI, a fase de fotos nunca é pulada. mock = padrão do compose local (valor desconhecido cai em mock).
FLYER_PRO_ENRICH_PROVIDER=real
# Lotes simultâneos no worker.
FLYER_PRO_ENRICH_CONCURRENCY=2
# Itens por lote de fotos (sempre múltiplo de 8, as chamadas do leitor de nomes), de categorias e de ortografia.
FLYER_PRO_ENRICH_IMAGE_BATCH=16
FLYER_PRO_ENRICH_CATEGORY_BATCH=40
FLYER_PRO_ENRICH_SPELL_BATCH=40
# Prazo do lote na fila (pg-boss expireInSeconds), da chamada ao provedor dentro do lote (passou, falha transitória AI_TIMEOUT)
# e lote em execução sem batimento por tanto tempo é dado por morto.
FLYER_PRO_ENRICH_BATCH_EXPIRE_SECONDS=300
FLYER_PRO_ENRICH_BATCH_DEADLINE_MS=240000
FLYER_PRO_ENRICH_STALE_SECONDS=60
# Tentativas seguidas sem avanço antes de o job falhar.
FLYER_PRO_ENRICH_MAX_ATTEMPTS=3
