# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stepup_user
DB_PASSWORD=secret123
DB_DATABASE=flyer_db

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=604800

# App
PORT=3001
NODE_ENV=development

# Upload
# Diretório dos uploads. Relativo (./uploads) é resolvido contra o diretório corrente do processo UMA VEZ, no boot (log
# "Uploads em <caminho>"); em produção o cwd do PM2 é /opt/encarte/backend. Recomendado em produção: caminho absoluto, igual
# para a API e o worker (o render Remotion troca o cwd durante o bundle).
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Base URL
BASE_URL=http://localhost:3001/v1
CDN_URL=http://localhost:3001/uploads
FRONTEND_URL=http://localhost:3000

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Encartes" <no-reply@encartes.local>

# AI
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_FAST_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_PREVIEW_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_PREVIEW_QUALITY=medium
OPENAI_IMAGE_DEFAULT_MODE=final
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=85
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_ENABLE_DALLE_FALLBACK=false
OPENAI_DALLE_FALLBACK_MODEL=dall-e-3
OPENAI_COST_TEXT_INPUT_1M_USD=
OPENAI_COST_TEXT_OUTPUT_1M_USD=
OPENAI_COST_IMAGE_FINAL_USD=
OPENAI_COST_IMAGE_PREVIEW_USD=
OPENAI_IMAGE_CONCURRENCY_LIMIT=2
OPENAI_IMAGE_RETRY_ATTEMPTS=2
OPENAI_IMAGE_RETRY_BASE_DELAY_MS=750
OPENAI_IMAGE_RETRY_MAX_DELAY_MS=5000
OPENAI_STRUCTURED_RESPONSE_RETRY_ATTEMPTS=1
PIXABAY_API_KEY=your_pixabay_api_key

# Replicate (SAM segmentation)
REPLICATE_API_TOKEN=r8_...

# Catálogo DotCompany por EAN (openspec catalogo-dotcompany-ean)
# A DotCompany limita só por minuto (Free 30, Starter 120, Pro 600 req/min) e
# pelo saldo de créditos (1 crédito = R$ 0,01; EAN encontrado = 4 créditos;
# não encontrado é grátis). Os limites por hora/dia abaixo são NOSSOS: trava
# de orçamento. Sem token, nenhuma consulta é feita e o encarte segue pelo
# casamento por nome.
DOTCOMPANY_API_TOKEN=
DOTCOMPANY_BASE_URL=https://erp.dotcompany.com.br/api/v1
DOTCOMPANY_RPM=30
DOTCOMPANY_MAX_REQUESTS_HOUR=600
DOTCOMPANY_MAX_REQUESTS_DAY=5000
DOTCOMPANY_MAX_CREDITS_HOUR=4000
DOTCOMPANY_MAX_CREDITS_DAY=12000
# Abaixo disso as importações em lote param; o encarte continua consultando.
DOTCOMPANY_RESERVE_CREDITS=400
# Abaixo disso sai o e-mail de saldo baixo (uma vez, até o saldo subir de novo).
DOTCOMPANY_ALERT_CREDITS=1000
DOTCOMPANY_BALANCE_REFRESH_MIN=15
DOTCOMPANY_ALERT_EMAIL=
# Runner dos jobs de importação de cadastro e teto padrão por job (créditos).
EAN_IMPORT_RUNNER_ENABLED=true
EAN_IMPORT_DEFAULT_CAP_CREDITS=12000
# Resolução por EAN na busca de imagens do encarte (prazo da requisição).
EAN_FLYER_RESOLVE_ENABLED=true
EAN_FLYER_RESOLVE_TIMEOUT_MS=20000
# Fase 2: ligador por âncora (off | measure | write). Só "write" grava EAN em fotos antigas.
EAN_ANCHOR_LINKER_MODE=off
# Pipeline antigo de vínculo EAN por juízes (substituído). Desligado por padrão.
EAN_JOB_RUNNER_ENABLED=false
# Comerciais com mascote (módulo commercials)
MC_ENABLED=false                      # liga rotas e consumers do módulo
MC_CREDITS_ENABLED=false              # cobrança da família 'commercials'
MC_SCRIPT_PROVIDER=mock               # mock | openai
MC_KIT_PROVIDER=mock                  # mock | gemini
MC_PIPELINE_PROVIDER=mock             # mock | real (fal/Kling + ElevenLabs + Gemini)
MC_DIRECTOR_MODEL=                    # modelo do diretor (default OPENAI_TEXT_MODEL / gpt-4o)
# Pipeline v2 (ADR-001): executor congelado por projeto na criação
MC_PIPELINE_V2=off                    # off | all | cohort
MC_PIPELINE_V2_USERS=                 # ids de usuário (vírgula) quando cohort
MC_TRANSLATION_PROVIDER=mock          # mock (fallback pt explícito) | openai (derivação PT→EN)
MC_KEYFRAME_MAX_REFERENCES=3          # limite de referências enviadas ao gerador de keyframe
MC_KEYFRAME_INCLUDE_ORIGINAL=false    # experimento P4: incluir a imagem original do mascote
MC_PIPELINE_MOCK_LATENCY_MS=4000      # latência simulada do provider mock
MC_MOCK_TTS_MAX_S=20                  # teto (s) da duração do TTS mock (15 chars/s); baixe só para encurtar os áudios do mock.
                                      # Para exercitar SPEECH_SENTENCE_TOO_LONG, mantenha-o ACIMA do maxChunkS do motor (15 s)
                                      # e use uma fala longa (270 caracteres = 18 s com o teto 20); abaixo disso o bloqueio não ocorre
# Entrega da voz (ElevenLabs voice_settings) — vale para o preview E o TTS das cenas
MC_TTS_SPEED=1.12                     # 0.7–1.2 (1 = natural; >1 mais rápido)
MC_TTS_STYLE=0.45                     # 0–1 expressividade (exagero de estilo)
MC_TTS_STABILITY=0.4                  # 0–1 (menor = mais emoção; eleven_v3 arredonda para 0 / 0.5 / 1)
MC_TTS_SIMILARITY=0.75                # 0–1 fidelidade ao timbre
MC_TTS_SPEAKER_BOOST=true
MC_CLIP_TEXT_CHECK=on                 # inspeção do clipe (Gemini visão): texto inventado ⇒ regera até 3×; off desliga
# Formatos de vídeo novos admitidos (change video-formatos-personagem): lista separada por vírgula.
# Vazio = nenhum formato novo; o formato de cenas ('scenes') sempre passa. Token desconhecido derruba o boot.
MC_FORMATS=                           # talking_art | offer_carousel | offer_piece
# Motores de fala por tier e origem (design D2): "modelo no fal | US$ por segundo | máximo de segundos por chamada"
MC_TALK_ENGINE_ECONOMICO=fal-ai/kling-video/ai-avatar/v2/standard|0.0562|15
MC_TALK_ENGINE_PREMIUM=fal-ai/kling-video/ai-avatar/v2/pro|0.115|15
MC_TALK_ENGINE_LOGO=minimax/h3-max/lip-sync/image-to-video|0.08|15
# Premium alternativo do bake-off (tarefa 7.1): OmniHuman 1.5 em 1080p, áudio ≤ 30 s por chamada (720p: ≤ 60 s)
# MC_TALK_ENGINE_PREMIUM=fal-ai/bytedance/omnihuman/v1.5|0.16|30
# Fala contínua (change video-fala-continua, design D16): as falas consecutivas viram UMA chamada do motor por trecho
# (áudio dos TTS emendado com os silêncios da timeline), em vez de uma chamada por fala; o personagem não "reinicia" a pose
# entre as frases. A flag é lida só pela API, na criação do projeto, e fica CONGELADA no roteiro dele (talkMode): ligar ou
# desligar depois não muda projetos já criados; "duplicar" relê a flag. GET /v1/commercials/config informa o modo.
# Vale para offer_piece e talking_art; offer_carousel e o formato de cenas não mudam.
MC_TALK_CONTINUOUS=false              # true liga o modo contínuo para projetos NOVOS; desligado = comportamento de hoje
# Teto (s) de áudio por trecho. Acima dele as falas se dividem em mais trechos (a junção usa o último quadro do trecho
# anterior). Sempre <= maxChunkS do MC_TALK_ENGINE_* (15 hoje; o teto por fala não muda); vazio = maxChunkS do motor.
# 10 é provisório (a medição do Kling foi inconclusiva): a calibração sai do cenário real da task 3.4. Valor que não seja
# número > 0 derruba o boot, como MC_TALK_ENGINE_*. Regravar uma fala regrava o trecho inteiro e os seguintes: quanto maior
# o teto, mais caro refazer uma frase (a cotação mostra o valor antes de confirmar).
MC_TALK_CHUNK_MAX_S=10
# Espera (s) por segundo de áudio no provider_wait do talk de trecho (lido pelo worker); piso 15 min, teto 40 min.
MC_TALK_POLL_PER_AUDIO_S=150
GEMINI_IMAGE_MODEL_REFS=              # modelo das 4 referências do kit (default: GEMINI_IMAGE_MODEL); ex.: gemini-nano-banana-2.1
# Tarifas do custo registrado do kit (tarefa 2.6): "modelo|US$ por imagem|US$ por 1M tokens de entrada|US$ por 1M de saída",
# separadas por vírgula. Vazio = tabela padrão abaixo (domain/mc-kit-costs.ts); cada entrada substitui a do mesmo modelo
# (campo vazio herda o padrão) ou acrescenta um modelo (os três números obrigatórios). Mal escrita derruba o boot.
# Padrão: nano-banana-pro-preview|0.134|2|12, gemini-3-pro-image-preview|0.134|2|12, gemini-nano-banana-2.1|0.034|2|12,
#         gpt-4o|0|2.5|10, gpt-4o-mini|0|0.15|0.6, gemini-3.8-flash|0|0.5|3
# (imagens: design.md; tokens da 2.1 = teto da Pro; gemini-3.8-flash = referência do Gemini 3 Flash, a confirmar)
MC_KIT_PRICES=
MC_KIT_CANDIDATE_COUNT=4              # candidatos de mascotização por rodada (kit de logo), sempre entre 4 e 6
MC_KIT_STYLE_REFS_DIR=                # opcional: pasta com referências de estilo {cartoon_2d|3d_render|realistic}-{1..3}.png
                                      # enviadas junto com o logo na rodada de candidatos; vazio = só o logo + bloco de estilo
MC_MOUTH_GATE_MOCK=passed             # só com MC_KIT_PROVIDER=mock: veredito do gate de boca (passed | blocked | undecided)
MC_LOGO_LOCATOR_MOCK=found            # só com MC_KIT_PROVIDER=mock: localização do logo na arte (found | not_found | low)
MC_PRICE_DETECT_MOCK=none             # só com MC_KIT_PROVIDER=mock: preços na arte p/ o aviso "janela sobre preço"
                                      # (none | overlap = preço sob a janela default | error = visão indisponível)
# Personagem sem fundo e enquadramento de corpo (change video-mascote-transparente; técnica: fala gerada sobre cor-chave
# verde/azul e recorte no ffmpeg do worker, custo de API a mais = 0)
MC_CHARACTER_CUTOUT=false             # true liga o modo "sem fundo" (panel.shape 'none') e framing 'corpo' na peça e na arte que fala;
                                      # desligado: 422 CHARACTER_CUTOUT_DISABLED e GET /v1/commercials/config informa characterCutout.enabled=false.
                                      # Lida só pela API; projetos já criados com o modo terminam mesmo com a flag desligada.
MC_CUTOUT_MOCK=stable                 # só com MC_PIPELINE_PROVIDER=mock (worker): stable | unstable — o clipe mock mantém ou varia o tom do
                                      # fundo-chave (fixture da reprovação do recorte, needs_attention). Não chama API paga.
GC_DRY_RUN=true                       # GC diário de uploads no worker (animations + commercials): só apaga com false
MC_RENDER_BROWSER=                    # executável do navegador do render (Alpine: /usr/bin/chromium-browser). Vazio = navegador
                                      # ausente: 'offer_carousel' fica indisponível no preflight E a criação recusa com 422
                                      # RENDER_UNAVAILABLE — inclusive no e2e mock (o preflight não distingue o renderizador mock)
# Render da composição Remotion do F2 'ofertas em sequência' (tarefa 6.5; fila mc.render, concorrência 1, expiração 900 s)
MC_COMPOSITION_VERSION=0.3.0          # versão das composições (@chroma/video-templates#compositionVersion); entra no hash do render;
                                      # com o pacote carregado vale a versão dele — este valor é o do renderizador mock
MC_RENDER_ASSET_BASE_URL=             # base das URLs de mídia que o navegador do render busca (vazio = http://127.0.0.1:3001;
                                      # stack docker: http://backend:3001 se o worker não alcança a API em 127.0.0.1)
MC_CAROUSEL_RENDERER=                 # remotion | mock — força o renderizador do F2; vazio = mock com MC_PIPELINE_PROVIDER=mock,
                                      # senão remotion (@remotion/bundler + @remotion/renderer + @chroma/video-templates)
MC_VIDEO_TEMPLATES_DIR=               # opcional: checkout local do pacote de templates (bundle e @remotion/* resolvidos dele);
                                      # vazio = node_modules/@chroma/video-templates do backend
MC_RENDER_FONT_FILE=                  # só para o PREFLIGHT: caminho da DejaVuSans.ttf quando instalada fora dos caminhos usuais e sem
                                      # fontconfig. Vazio = automático (caminhos usuais ou fc-list). O drawtext NÃO lê esta variável:
                                      # ele resolve a fonte pelo fontconfig (instale ttf-dejavu/fonts-dejavu-core + fontconfig)
FFMPEG_PATH=                          # binário do ffmpeg no worker (vazio = 'ffmpeg' no PATH); o preflight reporta a versão no /v1/health
FFPROBE_PATH=                         # idem para o ffprobe
FAL_API_KEY=                          # fal.ai (Kling Avatar/ação) — pipeline real
ELEVENLABS_API_KEY=                   # TTS/música — pipeline real
GEMINI_API_KEY=                       # keyframes/kit — pipeline real

# Cena de template (Templates v2, change add-template-scene-persistence). O compose local já define estes valores.
TEMPLATE_SCENE_ENABLED=true           # liga o módulo de cenas (guard 404 quando falso) e a fila no backend/worker
TEMPLATE_SCENE_IMAGE_PROVIDER=mock    # mock (padrão, sem custo) | openai (passada real do dono, ver docs/environment.md)
TEMPLATE_SCENE_IMAGE_MODEL=gpt-image-2.5-sunburst
TEMPLATE_SCENE_IMAGE_QUALITY=high
TEMPLATE_SCENE_CONCURRENCY=1
TEMPLATE_SCENE_MOCK_LATENCY_MS=20000  # latência simulada do provedor mock
TEMPLATE_SCENE_MOCK_SLOW_MS=3000      # espera mínima do mock quando o pedido traz #lento (testes de cancelamento)
TEMPLATE_SCENE_ASSET_TTL_DAYS=7
TEMPLATE_SCENE_DELETED_RETENTION_DAYS=30
TEMPLATE_SCENE_MASTERS_KEPT=5
TEMPLATE_SCENE_GC_DRY_RUN=true        # GC das cenas: só apaga com false (ausente = true; o compose local usa false)
TEMPLATE_SCENE_MAX_PAID_CALLS_PER_MESSAGE=4
TEMPLATE_SCENE_VISION_MODEL=gpt-6-luna   # modelo de visão da conferência da edição local
TEMPLATE_SCENE_EDIT_QUALITY=high         # qualidade das edições com máscara
TEMPLATE_SCENE_FEATHER_PX=48             # feather da recomposição, em px
TEMPLATE_SCENE_MARGIN_RATIO=0.04         # margem em volta da região, proporção do recorte
TEMPLATE_SCENE_INSET_PX=40               # erosão da área editável antes da recomposição, em px
TEMPLATE_SCENE_NOOP_THRESHOLD=0.02       # abaixo disso a edição conta como "sem mudança"
TEMPLATE_SCENE_VISION_TIMEOUT_MS=20000   # tempo máximo da visão; passou, a resposta sai das métricas
OPENAI_TIMEOUT_MS=180000
ADMIN_API_TOKEN=                      # obrigatório no backend: protege POST /v1/template-scenes/admin/gc (header x-admin-token); defina um valor local
